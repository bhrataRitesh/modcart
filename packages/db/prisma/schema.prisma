datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  role          UserRole  @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  vendorProfile VendorProfile?
  oauthAccounts OAuthAccount[]
  sessions      Session[]
  wishlistItems WishlistItem[]
  cart          Cart?
  verificationTokens VerificationToken[]
  chatMessages ChatMessage[]
}

enum UserRole {
  CUSTOMER
  VENDOR
  VENDOR_STAFF
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING_VERIFICATION
}

model OAuthAccount {
  id         String @id @default(cuid())
  provider   String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  @@unique([provider, providerId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  label      String?
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean @default(false)

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")
}

model VendorProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  storeName     String       @unique
  storeSlug     String       @unique
  description   String?
  logo          String?
  banner        String?
  status        VendorStatus @default(PENDING)
  businessEmail  String?
  businessPhone  String?
  taxId          String?
  kycDocuments   Json?
  commissionRate Float       @default(10.0)
  stripeAccountId String?
  paypalMerchantId String?
  createdAt      DateTime     @default(now())

  products      Product[]
  vendorOrders  VendorOrder[]
  payouts       Payout[]
  chatMessages  ChatMessage[]
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model ChatMessage {
  id           String   @id @default(cuid())
  senderId     String
  sender       User     @relation(fields: [senderId], references: [id])
  vendorId     String
  vendor       VendorProfile @relation(fields: [vendorId], references: [id])
  isFromVendor Boolean  @default(false)
  content      String
  createdAt    DateTime @default(now())
}

model Product {
  id            String    @id @default(cuid())
  vendorId      String
  vendor        VendorProfile @relation(fields: [vendorId], references: [id])
  name          String
  slug          String    @unique
  description   String?
  shortDesc     String?
  status        ProductStatus @default(DRAFT)
  type          ProductType   @default(PHYSICAL)
  price         Float
  comparePrice  Float?
  costPrice     Float?
  sku           String?   @unique
  barcode       String?
  weight        Float?
  trackInventory Boolean  @default(true)
  stockQty      Int       @default(0)
  lowStockAlert Int       @default(5)
  seoTitle      String?
  seoDesc       String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categories    ProductCategory[]
  images        ProductImage[]
  variants      ProductVariant[]
  options       ProductOption[]
  reviews       Review[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  PHYSICAL
  DIGITAL
  CONFIGURABLE
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  seoTitle    String?
  seoDesc     String?

  productCategories ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
  @@id([productId, categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sku       String  @unique
  price     Float
  stockQty  Int     @default(0)
  imageId   String?

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model ProductOption {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  name      String
  type      OptionType
  required  Boolean    @default(false)
  values    ProductOptionValue[]
}

enum OptionType {
  SELECT
  RADIO
  CHECKBOX
  TEXT
  FILE
}

model ProductOptionValue {
  id        String        @id @default(cuid())
  optionId  String
  option    ProductOption @relation(fields: [optionId], references: [id])
  name      String
  priceMod  Float?
}

model StockEvent {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  change          Int
  previousStock   Int
  newStock        Int
  reason          StockReason
  referenceId     String?        // Order ID or other ref
  createdAt       DateTime       @default(now())
}

enum StockReason {
  RESTOCK
  ORDER_SALE
  RETURN
  MANUAL_ADJUSTMENT
  CANCELLATION
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  guestEmail      String?
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Float
  discountTotal   Float     @default(0)
  shippingTotal   Float     @default(0)
  taxTotal        Float     @default(0)
  total           Float
  currency        String      @default("USD")
  notes           String?
  ipAddress       String?
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  vendorOrders    VendorOrder[]
  payments        Payment[]
  shippingAddressId String?
  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?
  billingAddress    Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

model VendorOrder {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  vendorId        String
  vendor          VendorProfile @relation(fields: [vendorId], references: [id])
  status          OrderStatus   @default(PENDING)
  subtotal        Float
  commissionRate  Float
  commissionAmount Float
  vendorEarnings  Float
  payoutId        String?
  payout          Payout?       @relation(fields: [payoutId], references: [id])

  items           OrderItem[]
  createdAt       DateTime      @default(now())
}

model OrderItem {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  vendorOrderId   String?
  vendorOrder     VendorOrder?  @relation(fields: [vendorOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  name            String
  sku             String
  price           Float
  quantity        Int
  total           Float
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  provider        String
  providerTxId    String?
  amount          Float
  currency        String
  status          PaymentStatus
  createdAt       DateTime      @default(now())
}

model Payout {
  id              String        @id @default(cuid())
  vendorId        String
  vendor          VendorProfile @relation(fields: [vendorId], references: [id])
  amount          Float
  currency        String
  status          PayoutStatus  @default(PENDING)
  provider        String
  providerTxId    String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  vendorOrders    VendorOrder[]
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model PageVisit {
  id              String         @id @default(cuid())
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  vendorId        String?
  vendorProfile   VendorProfile? @relation(fields: [vendorId], references: [id])
  userId          String?
  visitorId       String         // Session ID or device ID
  path            String
  createdAt       DateTime       @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      TokenType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, type])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String   // e.g. "PRODUCT_CREATE", "VENDOR_APPROVE"
  resource        String   // e.g. "Product", "VendorProfile"
  resourceId      String?
  details         Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // e.g. "NEW_ORDER", "LOW_STOCK", "PAYOUT_SENT"
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  // Optional redirect link
  createdAt DateTime @default(now())
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Float
  minOrderAmount  Float        @default(0)
  maxDiscountAmount Float?
  startDate       DateTime?
  endDate         DateTime?
  usageLimit      Int?
  usedCount       Int          @default(0)
  isActive        Boolean      @default(true)
  vendorId        String?      // Optional: global or vendor-specific
  vendor          VendorProfile? @relation(fields: [vendorId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders          Order[]
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model FlashSale {
  id            String    @id @default(cuid())
  name          String
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  salePrice     Float
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
