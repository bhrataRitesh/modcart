# Database
DATABASE_URL=postgresql://modcart:modcart@localhost:5432/modcart

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=modcart-media
S3_REGION=us-east-1

# JWT
JWT_ACCESS_SECRET=replace-with-secure-secret
JWT_REFRESH_SECRET=replace-with-secure-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CLIENT_ID=ca_...

# PayPal
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=sandbox

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@modcart.local

# App
NODE_ENV=development
PORT=3001
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
VENDOR_URL=http://localhost:3003
